# Example environment variables for the React/Vite frontend.
# Copy this to `.env` in the frontend folder and replace values as needed.

# Firebase configuration for authentication. You can obtain these from your
# Firebase project settings after creating a web app.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# Base URL of the backend API. During development this is usually
# http://localhost:8000 but you can point it to a deployed server.
VITE_API_BASE_URL=http://localhost:8000
