# Copy this file to frontend/.env and fill values for local development

# Firebase (web app) — used by Vite frontend
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id

# API base (backend)
VITE_API_BASE_URL=http://localhost:8000

# Notes:
# - Do not commit real API keys to source control. Use environment variables in CI or a secrets manager for production.
