# === LLM Configuration ===
# OpenAI (Primary) - Get your key from: https://platform.openai.com/api-keys
# Replace 'your_openai_api_key_here' with your actual API key (sk-...)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Google Gemini (Fallback)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# === MongoDB Atlas Configuration ===
# Replace with your MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=app
MONGODB_DATABASE=terraform_agent_logs

# === GitHub Configuration ===
GITHUB_TOKEN=your_github_token_here

# === Cloud Provider Configuration ===
DEFAULT_PROVIDER=aws

# === AWS Configuration ===
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_PROFILE=default

# === Server Configuration ===
HOST=0.0.0.0
PORT=8000
DEBUG=False

# === Optional: Langfuse Tracing ===
# LANGFUSE_PUBLIC_KEY=your_public_key
# LANGFUSE_SECRET_KEY=your_secret_key
# LANGFUSE_HOST=https://cloud.langfuse.com
