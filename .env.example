# ==========================================
# 🚀 Terraform Cloud Agent Configuration (TEMPLATE)
# ==========================================

# -----------------
# 1. LLM Providers
# -----------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# -----------------
# 2. Cloud Providers
# -----------------
DEFAULT_PROVIDER=aws

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCP Configuration
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# GCP_ZONE=us-central1-a
# GCP_CREDENTIALS_PATH=

# -----------------
# 3. Observability
# -----------------
# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Firebase Authentication
FIREBASE_PROJECT_ID=terraformcloudagent-7cfb6
FIREBASE_SERVICE_ACCOUNT_PATH=./terraformcloudagent-7cfb6-firebase-adminsdk-fbsvc-0fad469fa4.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
REQUIRE_AUTH=true

# -----------------
# 4. Persistence
# -----------------
# MongoDB Atlas URI
MONGODB_URI=
MONGODB_DATABASE=terraform_agent

# -----------------
# 5. Application Settings
# -----------------
WORKSPACE_BASE_DIR=runs
DEBUG=true
LOG_LEVEL=INFO

# -----------------
# 6. SMTP Email Configuration
# -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Terraform Cloud Agent
SEND_EMAIL_ALERTS=true

# Approval Token Settings
APPROVAL_TOKEN_SECRET=change-this-secret-key
APPROVAL_TOKEN_EXPIRY_HOURS=24
BASE_URL=http://localhost:8000
