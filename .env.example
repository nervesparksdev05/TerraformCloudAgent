# ==========================================
# 🚀 Terraform Cloud Agent Configuration
# ==========================================

# -----------------
# 1. LLM Providers
# -----------------

# [Primary] OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.2

# [Fallback] Google Gemini Configuration
# Used if OpenAI is unavailable or rate-limited
GOOGLE_API_KEY=AIza-your-google-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# -----------------
# 2. Cloud Providers
# -----------------

# Default provider for requests (aws or gcp)
DEFAULT_PROVIDER=aws

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# GCP Configuration
# Free Tier Optimized Region: us-central1 (Iowa)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
# Path to service account JSON key file
GCP_CREDENTIALS_PATH=credentials.json

# -----------------
# 3. Observability
# -----------------

# Langfuse (Tracing & Monitoring)
# Sign up at: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------
# 4. Persistence
# -----------------

# MongoDB (Run State & Chat History)
# If empty or connection fails, falls back to file-based storage
MONGODB_URI=mongodb://localhost:27017/terraform_agent
MONGODB_DATABASE=terraform_agent

# -----------------
# 5. Application Settings
# -----------------

# Directory for storing run artifacts
WORKSPACE_BASE_DIR=runs

# Application logging
DEBUG=true
LOG_LEVEL=INFO
