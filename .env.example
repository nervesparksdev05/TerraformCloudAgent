# Copy this file to .env and fill in real values. DO NOT commit secrets.

# Core Services
PROM_URL=http://localhost:9090
MONGODB_URI=mongodb://localhost:27017/terraform_agent
MONGODB_DATABASE=terraform_agent

# LLM / Gemini
GEMINI_API_KEY=your-gemini-or-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Authentication / Firebase
# When REQUIRE_AUTH=true the backend expects a Firebase project and service account.
REQUIRE_AUTH=true
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/service-account.json  # path on the server (keep JSON out of git)
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# JWT fallback (used if applicable)
JWT_SECRET_KEY=change-me-to-a-secure-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=alerts@example.com
SMTP_FROM_NAME=Terraform Cloud Agent

# Langfuse observability (optional)
LANGFUSE_MODE=cloud  # or docker
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Terraform / MCP
ENABLE_TERRAFORM_MCP=false
TERRAFORM_MCP_SERVER=terraform-mcp-server

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Notes:
#  - Add your Firebase service account JSON to a secure location on the server and set FIREBASE_SERVICE_ACCOUNT_PATH accordingly.
#  - Never commit the service account JSON or real secret values to the repository.
#  - Use a secrets manager or CI/CD protected variables for production deployments.
